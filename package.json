{
  "name": "satstacker-docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "npm run sync-openapi && npm run gen-api-docs && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve --port ${PORT:-3000} --host 0.0.0.0 --no-open",
    "gen-api-docs": "docusaurus clean-api-docs all && docusaurus gen-api-docs all",
    "clean-api-docs": "docusaurus clean-api-docs all",
    "fetch-openapi": "node scripts/fetch-openapi.js",
    "sync-openapi": "node scripts/fetch-openapi.js --sync",
    "preview": "docusaurus serve --port 3000 --host 127.0.0.1 --no-open"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "docusaurus-plugin-openapi-docs": "5.0.2",
    "docusaurus-theme-openapi-docs": "5.0.2",
    "path-browserify": "^1.0.1",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/types": "3.10.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "webpack": "5.105.0",
    "@docusaurus/core": "$@docusaurus/core",
    "@docusaurus/theme-common": "3.10.1",
    "@docusaurus/plugin-content-docs": "3.10.1"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
