      "PartnerUserCreate": {
        "properties": {
          "partner_user_id": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Partner User Id",
            "examples": [
              "rhino_user_123"
            ]
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "auth_provider": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Auth Provider",
            "examples": [
              "apple",
              "google",
              "email"
            ]
          },
          "consent_accepted": {
            "type": "boolean",
            "title": "Consent Accepted"
          },
          "consent_version": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Consent Version",
            "examples": [
              "satstacker-smart-timing-v1"
            ]
          },
          "consent_timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Consent Timestamp"
          }
        },
        "type": "object",
        "required": [
          "partner_user_id",
          "consent_accepted",
          "consent_version",
          "consent_timestamp"
        ],
        "title": "PartnerUserCreate"
      },
      "PartnerPlanCreate": {
        "properties": {
          "partner_user_id": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Partner User Id"
          },
          "partner_plan_id": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Partner Plan Id"
          },
          "amount_usd": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Amount Usd"
          },
          "frequency": {
            "type": "string",
            "enum": [
              "daily",
              "weekly",
              "bi-weekly"
            ],
            "title": "Frequency"
          },
          "smart_timing_enabled": {
            "type": "boolean",
            "title": "Smart Timing Enabled",
            "default": true
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Date"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "paused",
              "cancelled"
            ],
            "title": "Status",
            "default": "active"
          }
        },
        "type": "object",
        "required": [
          "partner_user_id",
          "partner_plan_id",
          "amount_usd",
          "frequency"
        ],
        "title": "PartnerPlanCreate"
      },
      "PartnerPlanOut": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "partner_slug": {
            "type": "string",
            "title": "Partner Slug"
          },
          "partner_user_id": {
            "type": "string",
            "title": "Partner User Id"
          },
          "partner_plan_id": {
            "type": "string",
            "title": "Partner Plan Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "amount_usd": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Amount Usd"
          },
          "frequency": {
            "type": "string",
            "title": "Frequency"
          },
          "smart_timing_enabled": {
            "type": "boolean",
            "title": "Smart Timing Enabled"
          },
          "window_start": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Window Start"
          },
          "next_run": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Run"
          },
          "unspent_fiat_usd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unspent Fiat Usd"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "partner_slug",
          "partner_user_id",
          "partner_plan_id",
          "status",
          "amount_usd",
          "frequency",
          "smart_timing_enabled",
          "window_start",
          "next_run",
          "unspent_fiat_usd"
