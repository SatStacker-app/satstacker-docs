    "/partner/v1/plans": {
      "post": {
        "tags": [
          "Partner API"
        ],
        "summary": "Create Partner Plan",
        "description": "Creates or updates a Smart Timing DCA plan for a linked partner user.",
        "operationId": "plans",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
