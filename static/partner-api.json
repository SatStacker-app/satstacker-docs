{
  "openapi": "3.1.0",
  "info": {
    "title": "SatStacker Engine Partner API",
    "version": "1.0.0",
    "description": "Embed Smart Timing into your own DCA experience while keeping the customer relationship, custody, funding, and execution on your platform."
  },
  "servers": [
    {
      "url": "https://api.satstacker.app",
      "description": "Production"
    }
