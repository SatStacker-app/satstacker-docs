    "/partner/v1/users": {
      "post": {
        "tags": [
          "Partner API"
        ],
        "summary": "Create or Link Partner User",
        "description": "Creates or updates a partner user after they opt in to Smart Timing.",
        "operationId": "users",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerUserCreate"
              }
            }
          }
        },
        "responses": {
