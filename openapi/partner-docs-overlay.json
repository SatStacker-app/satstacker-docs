          "type": "array",
          "items": {
            "$ref": "#/components/schemas/MonthlyBillingUserOut"
          }
        }
      },
      "required": [
        "partner_slug",
        "month",
        "period_status",
        "limit",
        "offset",
        "count",
        "users"
      ]
    },
    "PartnerErrorOut": {
      "type": "object",
      "properties": {
        "detail": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            }
          ]
        }
      },
      "required": [
        "detail"
      ]
    }
  },
  "fields": {
    "ExecutionInstructionOut": {
      "window_id": "Original budget generation ID; newly generated instructions populate it.",
      "window_start": "Original UTC window anchor for this instruction.",
      "tranche_key": "Zero-based normal tranche index or failsafe; informational, not a deduplication key.",
      "amount_usd": "Maximum total customer debit including exchange fees for this instruction.",
      "idempotency_key": "Opaque attempt deduplication key; unchanged on lease redelivery. Do not construct or parse."
    },
    "PartnerPlanCreate": {
      "amount_usd": "All-in total customer debit budget per window, including exchange fees.",
      "start_date": "Create-only UTC anchor; omit for updates. Changing the existing anchor conflicts."
    },
    "PartnerPlanOut": {
      "amount_usd": "All-in USD spending budget including exchange fees.",
      "unspent_fiat_usd": "Available current-window budget after confirmed all-in debits and open reservations. This is a logical budget, not custody of funds."
    },
    "TradeConfirmIn": {
      "partner_order_id": "Unique exchange order ID, or a unique local attempt ID if no order was placed. Reuse on confirmation replay.",
      "executed_at": "UTC definitive exchange outcome time, required for filled/partial. Optional for failed/cancelled; omitted value uses confirmation time.",
      "usd_amount": "Actual total customer debit INCLUDING exchange fees. Positive, at most 2 decimal places; must not exceed reserved amount.",
      "btc_amount": "Net BTC actually credited, at most 8 decimal places; excludes unrelated subsequent withdrawals.",
      "execution_price": "Exchange fill price or VWAP before separate fees; stored to cents and positive after rounding.",
      "partner_fee_usd": "Exchange fee already INCLUDED in usd_amount; not an additional debit. Nonnegative for filled/partial; stored to cents. Failed/cancelled record zero.",
      "failure_reason": "Required for failed/cancelled. Omit for filled/partial."
    }
  },
  "schemaDescriptions": {
    "TradeConfirmIn": "Final outcomes only. Conditional required fields are encoded here; the API also enforces decimal precision, positivity, reserved-amount and lifecycle rules. See /execution-contract and /errors."
  },
  "conditionalRules": {
    "TradeConfirmIn": [
      {
        "if": {
          "properties": {
            "status": {
              "enum": [
                "filled",
                "partial"
              ]
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "required": [
            "executed_at",
            "usd_amount",
            "btc_amount",
            "execution_price"
          ],
          "properties": {
            "executed_at": {
              "title": "Executed At",
              "description": "UTC definitive exchange outcome time, required for filled/partial. Optional for failed/cancelled; omitted value uses confirmation time.",
              "type": "string",
              "format": "date-time"
            },
            "usd_amount": {
              "title": "Usd Amount",
              "description": "Actual total customer debit INCLUDING exchange fees. Positive, at most 2 decimal places; must not exceed reserved amount.",
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
                }
              ]
            },
            "btc_amount": {
              "title": "Btc Amount",
              "description": "Net BTC actually credited, at most 8 decimal places; excludes unrelated subsequent withdrawals.",
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
                }
              ]
            },
            "execution_price": {
              "title": "Execution Price",
              "description": "Exchange fill price or VWAP before separate fees; stored to cents and positive after rounding.",
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
                }
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "enum": [
                "failed",
                "cancelled"
              ]
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "required": [
            "failure_reason"
          ],
          "properties": {
            "failure_reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    ]
  },
  "operations": {
    "health": {
      "path": "/partner/v1/health",
      "method": "get",
      "responses": {
        "200": {
          "description": "Successful response",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerHealthOut"
              }
            }
          }
        }
      }
    },
    "me": {
      "path": "/partner/v1/me",
      "method": "get",
      "responses": {
        "200": {
          "description": "Successful response",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerIdentityOut"
              }
            }
          }
        },
        "401": {
          "description": "Missing, malformed, revoked or invalid API key",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerErrorOut"
              }
            }
          }
        },
        "403": {
          "description": "Partner or user not active",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerErrorOut"
              }
            }
          }
        }
      }
    },
    "update-user-status": {
      "path": "/partner/v1/users/{partner_user_id}",
      "method": "patch",
      "description": "Enable or disable a partner user. Disable pauses active plans and cancels/refunds never-delivered instructions. Delivered instructions remain settleable and can be redelivered until final confirmation.",
      "responses": {
        "401": {
          "description": "Missing, malformed, revoked or invalid API key",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerErrorOut"
              }
            }
          }
        },
        "403": {
          "description": "Partner or user not active",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerErrorOut"
              }
            }
          }
        }
      }
    },
    "register-webhook": {
      "path": "/partner/v1/webhooks",
      "method": "post",
      "description": "Register/reactivate a webhook and generate a new secret EVERY time, including unchanged URLs. Secret appears only in this response. Exclude from generic automatic retries; a lost response requires coordinated re-registration and verifier update.",
      "responses": {
        "401": {
          "description": "Missing, malformed, revoked or invalid API key",
