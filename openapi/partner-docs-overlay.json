    "plans": {
      "path": "/partner/v1/plans",
      "method": "post",
      "description": "Create or update a full plan representation. amount_usd is the all-in window budget including exchange fees. Cancelled plans are terminal. start_date is create-only. Resets return 409 while a delivered instruction is unresolved. Omitted status/smart_timing_enabled default to active/true.",
      "responses": {
        "401": {
          "description": "Missing, malformed, revoked or invalid API key",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerErrorOut"
              }
            }
          }
        },
        "403": {
          "description": "Partner or user not active",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerErrorOut"
              }
            }
          }
        },
        "400": {
          "description": "Request violates a financial rule",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerErrorOut"
              }
            }
          }
        },
        "404": {
          "description": "Record not found in this partner/environment",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerErrorOut"
              }
            }
          }
        },
        "409": {
          "description": "Conflicting ownership, lifecycle or confirmation",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerErrorOut"
              }
            }
          }
        }
      }
    },
    "executions-due": {
      "path": "/partner/v1/executions/due",
      "method": "get",
      "description": "Lease pending or expired-lease instructions for the authenticated environment. Default lease is five minutes. Redelivery keeps execution_id and idempotency_key. Treat keys as opaque. amount_usd is the maximum total customer debit including exchange fees. Delivered instructions remain settleable after pause/cancel/off. No exchange order is placed by this API call.",
      "responses": {
        "401": {
          "description": "Missing, malformed, revoked or invalid API key",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerErrorOut"
              }
            }
          }
        },
        "403": {
          "description": "Partner or user not active",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerErrorOut"
              }
            }
          }
        }
      }
    },
    "confirm-execution": {
      "path": "/partner/v1/executions/{execution_id}/confirm",
      "method": "post",
      "description": "Record a definitive exchange outcome. Filled/partial require executed_at, all-in usd_amount, net credited btc_amount and fill execution_price. Fees are already included in usd_amount. Partial is terminal: remaining exchange orders must not still be able to fill. Failed/cancelled require failure_reason and represent zero debit/BTC. Identical final payload replay succeeds; changed outcomes conflict. Never place another buy to retry confirmation.",
      "responses": {
        "200": {
          "description": "Successful response",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecutionConfirmationOut"
              }
            }
          }
        },
        "401": {
          "description": "Missing, malformed, revoked or invalid API key",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerErrorOut"
              }
            }
          }
        },
        "403": {
          "description": "Partner or user not active",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerErrorOut"
              }
            }
          }
        },
        "400": {
          "description": "Request violates a financial rule",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerErrorOut"
              }
            }
          }
        },
        "404": {
          "description": "Record not found in this partner/environment",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerErrorOut"
              }
            }
          }
        },
        "409": {
          "description": "Conflicting ownership, lifecycle or confirmation",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerErrorOut"
              }
            }
          }
        }
      }
    },
    "billing-monthly": {
      "path": "/partner/v1/billing/monthly",
      "method": "get",
      "description": "Monthly aggregates based on executed_at. executed_volume_usd includes the all-in customer debit, including exchange fees; partner fees are separate. closed means the calendar period ended, not an immutable snapshot. Late confirmations can change results. Funded-user count uses plans' current Smart Timing enabled status; headline volume does not apply that plan filter.",
      "responses": {
        "200": {
          "description": "Successful response",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MonthlyBillingOut"
              }
            }
          }
        },
        "401": {
