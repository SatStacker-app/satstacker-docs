              }
            }
          }
        },
        "403": {
          "description": "Partner or user not active",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerErrorOut"
              }
            }
          }
        }
      }
    },
    "billing-monthly-users": {
      "path": "/partner/v1/billing/monthly/users",
      "method": "get",
      "description": "Offset-paginated per-user totals based on executed_at. Current smart_timing_enabled status filters plan eligibility, so disabling can affect historical views. Not an order-level audit export. Preserve partner-side month-end snapshots.",
      "responses": {
        "200": {
          "description": "Successful response",
