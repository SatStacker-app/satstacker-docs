{
  "revision": "2026-10-05-partner-v2-all-in",
  "info": {
    "title": "SatStacker Engine Partner API",
    "description": "Embed Smart Timing using partner-scoped test/live API keys. Plan and instruction USD amounts limit total customer debit INCLUDING exchange fees. Confirm actual all-in USD debit and net BTC credited; partner_fee_usd is the fee breakdown already inside that debit. SatStacker does not execute exchange orders. Only final exchange outcomes may be confirmed. Lease redelivery retains identity. See /execution-contract, /sandbox-testing and /operations in the partner docs.",
    "version": "1.0.0",
    "contact": {
      "name": "SatStacker Support",
      "email": "support@satstacker.app"
    },
    "x-documentation-revision": "2026-10-05-partner-v2-all-in"
  },
  "externalDocs": {
    "url": "https://docs.satstacker.app",
    "description": "Partner integration documentation"
  },
  "schemas": {
    "PartnerHealthOut": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "time": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "status",
        "service",
        "time"
      ]
    },
    "PartnerIdentityOut": {
      "type": "object",
      "properties": {
        "partner_slug": {
          "type": "string"
        },
        "partner_name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "environment": {
          "type": "string",
          "enum": [
            "test",
            "live"
          ]
        }
      },
      "required": [
        "partner_slug",
        "partner_name",
        "status",
        "environment"
      ]
    },
    "ExecutionConfirmationOut": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "execution_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "filled",
            "partial",
            "failed",
            "cancelled"
          ]
        },
        "partner_order_id": {
          "type": "string"
        },
        "replayed": {
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "execution_id",
        "status",
        "partner_order_id"
      ]
    },
    "WebhookDeleteOut": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "partner_slug": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "deleted": {
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "partner_slug",
        "environment",
        "deleted"
      ]
    },
    "PartnerPricingOut": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "string"
        },
        "subscription_rate_usd_per_user": {
          "type": "string",
          "pattern": "^-?\\d+\\.\\d{2}$",
          "description": "USD decimal string with two places"
        },
        "volume_rate_bps": {
          "type": "string",
          "pattern": "^-?\\d+\\.\\d{2}$",
          "description": "USD decimal string with two places"
        },
        "tier_overridden": {
          "type": "boolean"
        },
        "subscription_overridden": {
          "type": "boolean"
        },
        "volume_overridden": {
          "type": "boolean"
        }
      },
      "required": [
        "tier",
        "subscription_rate_usd_per_user",
        "volume_rate_bps",
        "tier_overridden",
        "subscription_overridden",
        "volume_overridden"
      ]
    },
    "MonthlyBillingOut": {
      "type": "object",
      "properties": {
